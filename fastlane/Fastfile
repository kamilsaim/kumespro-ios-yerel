# KümesPro iOS (yerel SwiftUI) — bulut derlemesi (GitHub Actions çağırır, elle çalıştırılmaz).
# Akış: API anahtarı → sertifika → iki App Store profili (uygulama + widget) → elle imza → arşiv → TestFlight.
default_platform(:ios)

PAKET  = "com.kamilsaim.kumespro"
WIDGET = "com.kamilsaim.kumespro.KumesProWidget"
TAKIM  = "NBTXFU47EV"

platform :ios do
  desc "Derle, imzala ve TestFlight'a yükle"
  lane :testflight_yukle do
    setup_ci # geçici anahtarlık (fastlane_tmp_keychain)

    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true
    )

    import_certificate(
      certificate_path: "dagitim.p12",
      certificate_password: ENV["DIST_CERT_PASSWORD"],
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # Uygulama: Apple ile Giriş + App Group; widget: App Group (Capacitor döneminden portalda bağlı)
    get_provisioning_profile(app_identifier: PAKET, force: true)
    profil = lane_context[SharedValues::SIGH_NAME]
    get_provisioning_profile(app_identifier: WIDGET, force: true)
    profil_widget = lane_context[SharedValues::SIGH_NAME]

    proje = "KumesPro.xcodeproj"
    update_code_signing_settings(
      path: proje, targets: ["KumesPro"], build_configurations: ["Release"],
      use_automatic_signing: false, team_id: TAKIM,
      code_sign_identity: "Apple Distribution", profile_name: profil,
      entitlements_file_path: "KumesPro/KumesPro.entitlements"
    )
    update_code_signing_settings(
      path: proje, targets: ["KumesProWidget"], build_configurations: ["Release"],
      use_automatic_signing: false, team_id: TAKIM,
      code_sign_identity: "Apple Distribution", profile_name: profil_widget,
      entitlements_file_path: "KumesProWidget/KumesProWidget.entitlements"
    )

    build_app(
      project: proje,
      scheme: "KumesPro",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { PAKET => profil, WIDGET => profil_widget } },
      output_directory: "build",
      output_name: "KumesPro.ipa",
      clean: true
    )

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
